{
  "name": "darkroom-theme",
  "displayName": "Darkroom: Event Horizon",
  "description": "A black hole inspired dark theme: near-black surfaces, starlight text, violet control flow, and accretion-gold functions.",
  "version": "0.1.0",
  "publisher": "blankmax",
  "author": {
    "name": "Hamiz Ali"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blink616/event-horizon-vscode.git"
  },
  "homepage": "https://github.com/blink616/event-horizon-vscode#readme",
  "bugs": {
    "url": "https://github.com/blink616/event-horizon-vscode/issues"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#07080d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "black-hole",
    "space",
    "event-horizon",
    "darkroom"
  ],
  "scripts": {
    "build": "node --import tsx src/build.ts",
    "watch": "node --watch --import tsx src/build.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm format:check && node --import tsx src/build.ts --check && pnpm test",
    "test": "node --import tsx --test tests/*.test.ts",
    "vscode:prepublish": "pnpm build && pnpm check",
    "package": "vsce package --no-dependencies --out dist/",
    "pulse:build": "node --import tsx scripts/build-pulse.ts",
    "pulse:typecheck": "tsc -p companion/tsconfig.json && tsc -p companion/tsconfig.webview.json && tsc -p scripts/tsconfig.json",
    "pulse:test": "node --import tsx --test companion/tests/*.test.ts",
    "pulse:check": "pnpm pulse:typecheck && pnpm pulse:test",
    "pulse:package": "pnpm pulse:check && node --import tsx scripts/build-pulse.ts --package"
  },
  "contributes": {
    "themes": [
      {
        "label": "Darkroom: Event Horizon",
        "uiTheme": "vs-dark",
        "path": "./themes/darkroom-color-theme.json"
      }
    ]
  },
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.4",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
